{ config, lib, pkgs, host, ... }:

let
  # NTFS data drive, see the fileSystems entries below.
  ntfs = uuid: {
    device = "/dev/disk/by-uuid/${uuid}";
    fsType = "ntfs3";
    options = [ "uid=1000" "gid=100" "windows_names" "noatime"
                "nofail" "x-systemd.device-timeout=10s" "x-gvfs-show" ];
  };
in
{
  # --- Boot ---
  boot.loader.systemd-boot.enable = lib.mkForce false;   # Lanzaboote replaces systemd-boot install
  boot.loader.systemd-boot.configurationLimit = 15;   # Each UKI is ~50-80MB, keep ESP usage under control
  boot.loader.efi.canTouchEfiVariables = true;
  boot.loader.timeout = 30;   # 30s menu delay for dual-boot drive selection
  boot.lanzaboote = {
    enable = true;
    pkiBundle = "/var/lib/sbctl";   # Secure Boot signing keys (generated by sbctl create-keys)
  };
  boot.kernelPackages = pkgs.linuxPackages_latest;   # Latest kernel for newest hardware support
  # Second onboard ethernet port (eno1, Killer/Atheros) is unused. Removing it
  # keeps wayle's network module from picking it: wayle-network takes the
  # first ethernet device NetworkManager lists, not the active one, and eno1
  # was listed before the real port (enp35s0, r8169). NM's "unmanaged" isn't
  # enough -- unmanaged devices are still enumerated.
  boot.blacklistedKernelModules = [ "alx" ];
  boot.kernelParams = [
    # Keep panic/oops logs large enough to preserve the useful tail.
    # EFI pstore writes to UEFI NVRAM, so keep this modest.
    "pstore.kmsg_bytes=65536"
    "efi_pstore.record_size=4096"
  ] ++ lib.optionals host.nvidia [
    "nvidia_drm.fbdev=1"   # NVIDIA framebuffer (Wayland)
  ];

  # tmpfs on RAM -- faster builds, reduces SSD writes
  boot.tmp.useTmpfs = true;
  boot.tmp.tmpfsSize = host.tmpfsSize;

  # --- Kernel hang / panic safety net ---
  # Escape hatch if a driver BUG() wedges the machine (e.g. mt7925e list_add corruption).
  # Without these a kernel BUG can silently deadlock every CPU waiting on orphaned locks.
  boot.kernel.sysctl = {
    "kernel.panic_on_oops" = 1;      # BUG()/oops => panic, don't try to limp on
    "kernel.panic" = 10;             # reboot 10s after panic
    "kernel.hardlockup_panic" = 1;   # CPU ignored IRQs >10s => panic via NMI
    "kernel.softlockup_panic" = 1;   # CPU looped in kernel >20s => panic
    "kernel.hung_task_panic" = 1;    # task stuck in D-state >120s => panic
  };
  # Hardware watchdog -- sp5100_tco on this AMD chipset. If systemd stops
  # pinging it, the chipset itself resets the box. Only backstop that survives
  # a full deadlock where every CPU is stuck and software watchdogs can't run.
  # Set above the 120s hung_task threshold so the software panic detectors win
  # the race and dump a backtrace to pstore first. A shorter timeout resets
  # blind, before any culprit is captured.
  systemd.settings.Manager.RuntimeWatchdogSec = "150s";

  # AMD CPU microcode updates -- security and stability patches
  hardware.cpu.amd.updateMicrocode = true;

  # Btrfs -- reduces SSD writes (noatime) and saves space (zstd compression)
  fileSystems."/".options = [ "noatime" "compress=zstd" ];
  fileSystems."/home".options = [ "noatime" "compress=zstd" ];

  # NTFS data drives, mounted at boot with the in-kernel ntfs3 driver.
  #  - nofail + short timeout: a missing/unmountable drive never blocks boot.
  #  - ntfs3 refuses to mount a volume Windows left "dirty" (Fast Startup /
  #    hibernation) -- that's a safety feature; disable Fast Startup in
  #    Windows if /mnt/cdrive doesn't show up.
  #  - windows_names: refuse file names Windows can't open.
  #  - x-gvfs-show: list them in the file manager sidebar.
  fileSystems."/mnt/cdrive" = ntfs "5E22E87B79FB8B5A";   # Samsung 990 Pro 1 -- Windows C:
  fileSystems."/mnt/ddrive" = ntfs "01DD6502633B8D10";   # Samsung 990 Pro 2
  fileSystems."/mnt/edrive" = ntfs "5E1E77E0C57314E1";   # WD Blue 4TB HDD

  # --- GPU ---
  hardware.graphics = {
    enable = true;
    enable32Bit = true;   # Needed for Steam/Proton 32-bit games
  };
  services.xserver.videoDrivers = lib.mkIf host.nvidia [ "nvidia" ];
  hardware.nvidia = lib.mkIf host.nvidia {
    modesetting.enable = true;
    open = true;                       # Open kernel modules -- required for 50-series (Blackwell) and newer
    nvidiaSettings = true;             # nvidia-settings GUI
    package = config.boot.kernelPackages.nvidiaPackages.latest;
  };

  # NVIDIA does not return its free buffer pool to the GPU under Wayland
  # compositors, so Hyprland's VRAM climbs across a session and never drops
  # when other apps need it. NVIDIA's own profile key GLVidHeapReuseRatio=0
  # caps that pool. Match argv[0] basename (Hyprland, as UWSM launches it)
  # plus the NixOS wrapper names as fallbacks so the rule binds regardless
  # of how the driver reads the process name.
  environment.etc."nvidia/nvidia-application-profiles-rc.d/50-limit-free-buffer-pool-in-wayland-compositors.json" =
    lib.mkIf host.nvidia {
      text = builtins.toJSON {
        rules = map (name: {
          pattern = { feature = "procname"; matches = name; };
          profile = "Limit Free Buffer Pool On Wayland Compositors";
        }) [ "Hyprland" ".Hyprland-wrapped" ".Hyprland-wrapp" ];
        profiles = [{
          name = "Limit Free Buffer Pool On Wayland Compositors";
          settings = [{ key = "GLVidHeapReuseRatio"; value = 0; }];
        }];
      };
    };

  # Allow non-root users to read GPU performance counters (ncu, CUPTI PC sampling).
  # Default gates this behind root to mitigate CVE-2018-6260 (GPU counter side-channel
  # between users on a shared GPU); single-user workstation, threat model doesn't apply.
  boot.extraModprobeConfig = lib.mkIf host.nvidia ''
    options nvidia NVreg_RestrictProfilingToAdminUsers=0
  '';

  # VA-API hardware video acceleration via NVIDIA
  environment.variables.LIBVA_DRIVER_NAME = lib.mkIf host.nvidia "nvidia";

  # --- Hardware Services ---
  services.fstrim.enable = true;        # Weekly SSD TRIM -- maintains write performance and longevity
  services.smartd.enable = true;        # Monitor SSD/HDD health via SMART -- warns before failure
  services.irqbalance.enable = true;    # Distribute hardware interrupts across CPU cores

  # --- Bluetooth ---
  hardware.bluetooth.enable = true;
  hardware.bluetooth.powerOnBoot = false;  # available, but off until turned on (tray / blueman)
  services.blueman.enable = true;       # Bluetooth GUI manager

  # --- Swap ---
  zramSwap.enable = true;              # Compressed RAM swap -- OOM pressure relief without SSD wear

  # --- Sleep disabled ---
  # NVIDIA RTX 5090 + open driver hangs GSP on S3 resume:
  # Xid 13/31 cascade, then Xid 154 "Node Reboot Required". Mask all sleep
  # targets so no path (logind, hypridle, power button) can trigger suspend.
  systemd.targets.sleep.enable = false;
  systemd.targets.suspend.enable = false;
  systemd.targets.hibernate.enable = false;
  systemd.targets.hybrid-sleep.enable = false;
  services.logind.settings.Login = {
    HandleSuspendKey = "ignore";
    HandleHibernateKey = "ignore";
    HandleLidSwitch = "ignore";
    HandleLidSwitchExternalPower = "ignore";
    HandleLidSwitchDocked = "ignore";
    IdleAction = "ignore";
  };
}

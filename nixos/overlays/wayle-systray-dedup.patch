+async fn owns_registered_item(
+    connection: &Connection,
+    items: &Arc<RwLock<Vec<String>>>,
+    bus_name: &str,
+) -> bool {
+    let names: Vec<String> = items
+        .read()
+        .await
+        .iter()
+        .filter(|item| !item.starts_with(':'))
+        .map(|item| item.split('/').next().unwrap_or(item).to_string())
+        .collect();
+
+    let Ok(dbus_proxy) = DBusProxy::new(connection).await else {
+        return false;
+    };
+
+    for name in names {
+        let Ok(well_known) = zbus::names::BusName::try_from(name.as_str()) else {
+            continue;
+        };
+        if let Ok(owner) = dbus_proxy.get_name_owner(well_known).await {
+            if owner.as_str() == bus_name {
+                return true;
+            }
+        }
+    }
+    false
+}
